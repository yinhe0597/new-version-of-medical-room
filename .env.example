# Optional external database. Configure exactly one database URL. If omitted,
# source and packaged runs use data/app.db. URL-encode reserved password chars.
# DATABASE_URL=mysql+pymysql://user:url_encoded_password@127.0.0.1:3306/medical_db?charset=utf8mb4
# URL query names are limited to charset, unix_socket, and the documented ssl_*
# options. Target/credential/timeout overrides such as host, database, user,
# password, port, init_command, autocommit, and unknown names are rejected before
# connecting. The runtime moves accepted options to direct PyMySQL arguments and
# removes all user-supplied query parameters before engine initialization; the
# framework may still display its fixed utf8mb4 charset default on the engine URL.

# Remote MySQL requires verified TLS before any connection is attempted.
# A localhost target (including an authorized SSH/cloud-proxy tunnel) may omit it.
# DATABASE_REQUIRE_TLS=1
# MYSQL_SSL_CA=C:/secure/provider-ca.pem
# MYSQL_SSL_CERT=C:/secure/client-cert.pem
# MYSQL_SSL_KEY=C:/secure/client-key.pem
# MYSQL_SSL_VERIFY_CERT=1
# MYSQL_SSL_VERIFY_IDENTITY=1

# External connection resilience. Defaults are suitable for one Waitress process.
# MYSQL_CONNECT_TIMEOUT=10
# MYSQL_READ_TIMEOUT=30
# MYSQL_WRITE_TIMEOUT=30
# MYSQL_POOL_SIZE=5
# MYSQL_MAX_OVERFLOW=10
# MYSQL_POOL_TIMEOUT=30
# MYSQL_POOL_RECYCLE=1800

# MySQL logical backup requires a compatible client installed on the app host.
# MYSQLDUMP_PATH=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe

# Every MySQL deployment requires these fail-closed values. Unsafe overrides are
# rejected at configuration time, including for localhost and Unix sockets.
# REQUIRE_ALEMBIC_HEAD=1
# RUNTIME_SCHEMA_SYNC_ENABLED=0
# PRODUCTION_DATABASE_PREFLIGHT_ENABLED=1

# Startup uses the bounded profile by default. Run --check-database for the full
# orphan scan before release; enable startup deep checks only when table sizes fit.
# PRODUCTION_DATABASE_DEEP_CHECKS_ENABLED=0
# MYSQL_PREFLIGHT_QUERY_TIMEOUT=10

# A migration backup must be fresh and bound to the current MySQL instance.
# Allowed range: 1-1440 minutes. Keep the safe one-hour default in production.
# MIGRATION_BACKUP_MAX_AGE_MINUTES=60

# Optional explicit secrets. When omitted, every startup path creates persistent
# random values in data/.runtime-secrets.json. Never use the placeholders below.
# SECRET_KEY=replace-with-at-least-32-random-characters
# JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Application-level login throttling. Limits are per client IP + username.
# Configure the reverse proxy with a broader global limit for distributed abuse.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900

# Comma-separated development origins. Packaged same-origin access needs no CORS.
CORS_ORIGINS=http://localhost:5888,http://127.0.0.1:5888

# Optional initial password used only when run_prod.py has to create missing
# bootstrap accounts. If omitted, a random temporary password is printed once.
# BOOTSTRAP_PASSWORD=replace-with-a-strong-temporary-password

# Bind to loopback by default and publish through a local HTTPS reverse proxy.
# Only expose the app directly when that proxy is not available.
SERVER_HOST=127.0.0.1

# Trust one reverse-proxy hop for client IP/scheme/host. Enable only while the
# app stays on loopback: it makes X-Forwarded-For reach the app (Waitress 3
# strips it otherwise), so throttling and audit logs record the real client.
# TRUST_PROXY_HEADERS=1

# Listening port. Defaults to 5000 when unset. Override if 5000 is occupied.
# SERVER_PORT=5000
