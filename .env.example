# Optional external database. If omitted, source and packaged runs use data/app.db.
# DATABASE_URL=mysql+pymysql://user:url_encoded_password@127.0.0.1:3306/medical_db?charset=utf8mb4

# Optional explicit secrets. When omitted, every startup path creates persistent
# random values in data/.runtime-secrets.json. Never use the placeholders below.
# SECRET_KEY=replace-with-at-least-32-random-characters
# JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Comma-separated development origins. Packaged same-origin access needs no CORS.
CORS_ORIGINS=http://localhost:5888,http://127.0.0.1:5888

# Optional initial password used only when run_prod.py has to create missing
# bootstrap accounts. If omitted, a random temporary password is printed once.
# BOOTSTRAP_PASSWORD=replace-with-a-strong-temporary-password

# Bind to loopback by default. For LAN deployment, keep the application behind
# an HTTPS reverse proxy and explicitly set SERVER_HOST=0.0.0.0.
SERVER_HOST=127.0.0.1
