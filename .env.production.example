# Copy this file to .env beside the executable only after selecting the target
# database. Never commit the resulting .env or any certificate/private key.

# Bind to loopback and publish through an HTTPS reverse proxy by default.
SERVER_HOST=127.0.0.1

# Packaged same-origin deployments do not need cross-origin API access.
CORS_ORIGINS=

# Enforce versioned schema and disable implicit production schema changes.
REQUIRE_ALEMBIC_HEAD=1
RUNTIME_SCHEMA_SYNC_ENABLED=0
PRODUCTION_DATABASE_PREFLIGHT_ENABLED=1
PRODUCTION_DATABASE_DEEP_CHECKS_ENABLED=0

# Keep these unset to use data/app.db after upgrading and preflighting a copy.
# For MySQL, URL-encode reserved password characters and uncomment DATABASE_URL.
# DATABASE_URL=mysql+pymysql://medical_app:URL_ENCODED_PASSWORD@db.example:3306/medical_db?charset=utf8mb4

# Remote MySQL must use a verified provider CA and hostname validation.
DATABASE_REQUIRE_TLS=1
# MYSQL_SSL_CA=C:/secure/provider-ca.pem
# MYSQL_SSL_CERT=C:/secure/client-cert.pem
# MYSQL_SSL_KEY=C:/secure/client-key.pem
MYSQL_SSL_VERIFY_CERT=1
MYSQL_SSL_VERIFY_IDENTITY=1

MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=1800
MYSQL_PREFLIGHT_QUERY_TIMEOUT=10
MIGRATION_BACKUP_MAX_AGE_MINUTES=60

# Set an absolute path when mysqldump is not available through PATH.
# MYSQLDUMP_PATH=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe

# Optional: generated values persist in data/.runtime-secrets.json when omitted.
# SECRET_KEY=<at-least-32-random-characters>
# JWT_SECRET_KEY=<different-at-least-32-random-characters>

# Optional one-time bootstrap password. Remove it after the first successful login.
# BOOTSTRAP_PASSWORD=<strong-temporary-password>
